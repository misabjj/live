{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/react-starter-kit",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ext-openssl": "*",
        "efipay/sdk-php-apis-efi": "^1.19",
        "erag/laravel-lang-sync-inertia": "^2.3",
        "inertiajs/inertia-laravel": "^3.1",
        "laravel/framework": "^13.0",
        "laravel/horizon": "^5.47",
        "laravel/nightwatch": "^1.28",
        "laravel/reverb": "^1.12",
        "laravel/socialite": "^5.28",
        "laravel/tinker": "^3.0",
        "laravel/wayfinder": "^0.1.20",
        "league/flysystem-aws-s3-v3": "^3.35",
        "mercadopago/dx-php": "^3.10",
        "pbmedia/laravel-ffmpeg": "^8.9",
        "predis/predis": "^3.5",
        "spatie/laravel-query-builder": "^7.3",
        "stripe/stripe-php": "^22.0"
    },
    "require-dev": {
        "brianium/paratest": "^7.27.4",
        "calebdw/phpstan-laravel": "^1.11",
        "fakerphp/faker": "^1.24",
        "laravel/boost": "^2.4",
        "laravel/pail": "^1.2.7",
        "laravel/pao": "^1.1",
        "laravel/pint": "^1.29",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.4",
        "pestphp/pest": "^5.3.3",
        "pestphp/pest-plugin-laravel": "^5.0.1",
        "phpstan/phpstan": "^2.3",
        "rector/rector": "^2.7",
        "spatie/guidelines-skills": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "bunx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74,#f9a8d4\" \"php artisan serve\" \"php artisan queue:listen --queue=default,alert,audio-processing --tries=1\" \"php artisan pail --timeout=0\" \"php artisan reverb:start\" \"bun run dev\" --names=server,queue,logs,reverb,vite --kill-others"
        ],
        "dev:ssr": [
            "bun run build:ssr",
            "Composer\\Config::disableProcessTimeout",
            "bunx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74,#f9a8d4\" \"php artisan serve\" \"php artisan queue:listen --queue=default,alert,audio-processing --tries=1\" \"php artisan pail --timeout=0\" \"php artisan reverb:start\" \"php artisan inertia:start-ssr\" --names=server,queue,logs,reverb,ssr --kill-others"
        ],
        "analyse": "@php vendor/bin/phpstan analyse --memory-limit=2G",
        "refactor:check": "@php vendor/bin/rector process --dry-run",
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test --parallel"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
